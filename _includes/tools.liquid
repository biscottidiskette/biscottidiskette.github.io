<div class="col mb-4">
  <a href="{% if tool.redirect %}{{ tool.redirect }}{% else %}{{ tool.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable"
         style="border-radius:0.5rem;
                border:1px solid #333;
                transition:transform 0.15s ease, box-shadow 0.15s ease;
                background-color:{% case tool.importance %}
                                    {% when 4 %}rgba(200,200,200,0.05)
                                    {% when 3 %}rgba(0,148,0,0.05)
                                    {% when 2 %}rgba(255,255,0,0.05)
                                    {% when 1 %}rgba(255,0,0,0.05)
                                    {% else %}transparent
                                  {% endcase %};">

      <div class="card-body">
        <h2 class="card-title">{{ tool.title }}</h2>
        <p class="card-text">{{ tool.description }}</p>
        <div class="row ml-1 mr-1 p-0">
          {% if tool.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ tool.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if tool.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ tool.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </a>
</div>
