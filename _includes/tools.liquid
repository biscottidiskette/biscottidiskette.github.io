<div class="col mb-4">
  <a href="{% if tool.redirect %}{{ tool.redirect }}{% else %}{{ tool.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable"
         style="border-radius:0.5rem;
                border:1px solid #333;
                transition:transform 0.15s ease, box-shadow 0.15s ease;
                background-color:{% case tool.importance %}
                                    {% when 4 %}rgba(200,200,200,0.05)
                                    {% when 3 %}rgba(0,148,0,0.05)
                                    {% when 2 %}rgba(255,255,0,0.05)
                                    {% when 1 %}rgba(255,0,0,0.05)
                                    {% else %}transparent
                                  {% endcase %};">

      <!-- Title -->
      <div class="card-header" style="font-weight:700; font-size:1.25rem; border-bottom:1px solid #ccc;">
        {{ tool.title }}
      </div>

      <!-- Description -->
      <div class="card-body">
        <p class="card-text">{{ tool.description }}</p>
      </div>

      <!-- Proof / Links -->
      {% if tool.github or tool.website or tool.internal_proof %}
        <div class="card-footer" style="border-top:1px solid #ccc; display:flex; gap:0.5rem; flex-wrap:wrap;">
          {% if tool.github %}
            <a href="{{ tool.github }}" class="btn btn-outline-dark btn-sm" target="_blank">
              <i class="fa-brands fa-github"></i> GitHub
              {% if tool.github_stars %}({{ tool.github_stars }}){% endif %}
            </a>
          {% endif %}
          {% if tool.website %}
            <a href="{{ tool.website }}" class="btn btn-outline-dark btn-sm" target="_blank">Website</a>
          {% endif %}
          {% if tool.internal_proof %}
            {% assign proof_page = site.pages | where: "url", tool.internal_proof | first %}
            <a href="{{ tool.internal_proof | relative_url }}" class="btn btn-sm"
              style="background-color:#007bff;color:#fff;border:none;">
              Proof: {% if proof_page %}{{ proof_page.title }}{% else %}Walkthrough{% endif %}
            </a>
          {% endif %}
        </div>
      {% endif %}

    </div>
  </a>
</div>
