{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      &copy; Copyright {{ site.time | date: '%Y' }} &nbsp; {{ site.title }} &nbsp;·&nbsp;
      <a href="https://github.com/biscottidiskette" target="_blank">GitHub</a> &nbsp;·&nbsp;
      <a href="https://app.hackthebox.eu/profile/biscottidiskette" target="_blank">HackTheBox</a> &nbsp;·&nbsp;
