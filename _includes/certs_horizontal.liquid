<div class="col">
  <a href="{% if cert.redirect %}{{ cert.redirect }}{% else %}{{ cert.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable d-flex flex-row align-items-center"
         style="background-color:
           {% case cert.subcategory %}
             {% when "red" %}rgba(255,0,0,0.1)
             {% when "blue" %}rgba(0,0,255,0.1)
             {% when "general" %}rgba(255,255,255,0.1)
             {% when "foundational" %}rgba(255,255,0,0.1)
             {% else %}transparent
           {% endcase %};
           border-radius:0.5rem;
           border:1px solid #333;
           transition:transform 0.15s ease, box-shadow 0.15s ease;">

      {% if cert.img %}
        {% include figure.liquid
           loading="eager"
           path=cert.img
           sizes="150px"
           alt="cert thumbnail"
           class="card-img-left" %}
      {% endif %}

      <div class="card-body">
        <h2 class="card-title" style="font-size:1.1rem; color:#fff;">{{ cert.title }}</h2>
        <p class="card-text" style="font-size:0.9rem; color:#aaa;">{{ cert.description }}</p>
      </div>
    </div>
  </a>
</div>
