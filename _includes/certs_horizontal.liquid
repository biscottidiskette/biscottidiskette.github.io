<div class="col">
  <a href="{% if cert.redirect %}{{ cert.redirect }}{% else %}{{ cert.url | relative_url }}{% endif %}">
    <div class="card mb-3 hoverable" style="display:flex; flex-direction:row; background-color:
         {% case cert.subcategory %}
           {% when "red" %}rgba(255,0,0,0.1)
           {% when "blue" %}rgba(2,62,138,0.1)
           {% when "general" %}rgba(255,255,255,0.1)
           {% when "foundation" %}rgba(255,255,0,0.1)
           {% else %}transparent
         {% endcase %};
         border-radius:0.5rem;
         border:1px solid #333;
         transition:transform 0.15s ease, box-shadow 0.15s ease;">
      
      {% if cert.img %}
        <div style="flex:0 0 120px;">
          {% include figure.liquid
             loading="eager"
             path=cert.img
             sizes="120px"
             alt="cert thumbnail"
             class="img-fluid rounded-start" %}
        </div>
      {% endif %}

      <div class="card-body" style="flex:1;">
        <h2 class="card-title">{{ cert.title }}</h2>
        <p class="card-text">{{ cert.description }}</p>
      </div>
    </div>
  </a>
</div>
